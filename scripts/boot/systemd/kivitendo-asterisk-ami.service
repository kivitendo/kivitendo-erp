[Unit]
Description=kivitendo Asterisk AMI integration async event listening
Requires=postgresql.service
After=postgresql.service

[Service]
Type=simple
# Change the user to the one your web server runs as.
User=www-data
# Change these two to point to the kivitendo "task_server.pl" location.
WorkingDirectory=/var/www/kivitendo-erp/
ExecStart=/var/www/kivitendo-erp/scripts/async_events_source_asterisk.pl -c kivi_client_name_or_id
#ExecStop=/var/www/kivitendo-erp/scripts/async_events_source_asterisk.pl stop
Restart=always
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
